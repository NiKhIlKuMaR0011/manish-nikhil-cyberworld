        <rect x="3" y="3" width="7" height="7" stroke="white" strokeWidth="1.5" rx="1" />
        <rect x="14" y="3" width="7" height="7" stroke="white" strokeWidth="1.5" rx="1" />
        <rect x="3" y="14" width="7" height="7" stroke="white" strokeWidth="1.5" rx="1" />
        <rect x="14" y="14" width="7" height="7" stroke="white" strokeWidth="1.5" rx="1" />
      </svg>
    ),
  },
];

function CardPlan({ title, price, perks, featured }) {
  return (
    <div className={`p-6 rounded-xl border ${featured ? "bg-gradient-to-br from-white/6 to-white/3 border-white/10 shadow-2xl" : "bg-white/4 border-white/6"}`}>
      <div className="flex items-baseline justify-between">
        <h4 className="font-semibold text-lg">{title}</h4>
        <div className="text-sm text-white/80">{price}</div>
      </div>
      <ul className="mt-4 space-y-2 text-white/80">
        {perks.map((p) => (
          <li key={p}>• {p}</li>
        ))}
      </ul>
      <div className="mt-6">
        <button className={`w-full py-3 rounded-lg font-semibold ${featured ? "bg-white text-slate-900" : "bg-white/6"}`}>{featured ? "Get Pro" : "Choose"}</button>
      </div>
    </div>
  );
}

function TrustLogo({ label }) {
  return (
    <div className="px-4 py-2 rounded-md bg-white/4 text-white/90 text-sm">{label}</div>
  );
}
